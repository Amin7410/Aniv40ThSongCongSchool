# Bắt buộc
DATABASE_URL=postgres://bosss:CHANGE_ME@postgres:5432/bosss
PAYLOAD_SECRET=CHANGE_ME_min_32_chars_random_string_xxxxxxxx
HASH_SECRET=CHANGE_ME_another_32_chars_random_string_xxxxx
NEXT_PUBLIC_SITE_URL=https://phongtruyenthong.example.edu.vn

# Khuyến nghị (rate limit dùng chung, realtime nhiều replica)
REDIS_URL=redis://redis:6379

# Lưu trữ file (mount volume trong Docker)
MEDIA_DIR=/data/media
QUARANTINE_DIR=/data/quarantine

# Tùy chọn
SSE_MAX_CONNECTIONS=4000
POW_MAX=60000
# POW_DISABLED=1   # chỉ dùng cho kiểm thử tải trên staging, không có tác dụng ở production

# Nginx gắn header này; ứng dụng chỉ tin X-Real-IP khi khớp (openssl rand -hex 32)
PROXY_SHARED_SECRET=CHANGE_ME
# Giám sát nội bộ gọi /api/health kèm X-Health-Token để xem chi tiết
HEALTH_TOKEN=CHANGE_ME

# Email (cảnh báo đổi tài khoản quỹ, quên mật khẩu). Bỏ trống → email ghi ra log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.edu.vn
